#!/bin/sh

if [ "$#" -lt 2 ]; then
	cat <<EOF
Usage: $0 PACKAGE EXECUTABLE

This is an alternative to 'nix bundle' that allow specifying the executable to
run. This is handy for derivations that haven't specified meta.mainProgram, or
contain multiple programs.

PACKAGE is a package in <nixpkgs> (i.e. the nixpkgs in your NIX_PATH), like
dnsutils, or more generally a Nix expression with nixpkgs in scope. It's not a
flake reference like nixpkgs#dnsutils.

EXECUTABLE can be either an absolute path (relative to the derivation path), or
a relative path (relative to the /bin subdirectory).

Example usage:

	$ ./bundle dnsutils /bin/dig # or ./bundle dnsutils dig
	$ ./dig.AppImage -v
	DiG 9.18.14
EOF
	exit 1
fi

case "$1" in
*'#'*)
	echo "$0: PACKAGE should be a package in <nixpkgs> like dnsutils, not a flake reference like nixpkgs#dnsutils" >&2
	exit 1
	;;
esac

NA_EXE="$2"
NA_OUTPUT=default
if [ "${NA_EXE#/}" = "$NA_EXE" ]; then
	# ${NA_EXE#/} = remove / from the start of NA_EXE
	NA_EXE="/bin/$NA_EXE"
	# like lib.getExe, use the output with the package's binaries, which isn't
	# always the default one (e.g. wayland-scanner)
	NA_OUTPUT=bin
fi

export NA_EXE NA_OUTPUT
# use an absolute path, since a relative one like nix-appimage would be taken as
# a flake registry name
nix bundle --impure --bundler "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)" \
	--expr '
	let
		pkgs = import <nixpkgs> {};
		p = with pkgs; '"$1"';
		base = if builtins.getEnv "NA_OUTPUT" == "bin" && builtins.isAttrs p then pkgs.lib.getBin p else p;
	in {
		type = "app";
		program = "${base}${builtins.getEnv "NA_EXE"}";
	}
	'
